# ==============================================================================
# CCTV Stream Collector - Local Environment Variables Template (.env-template)
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env-template .env
# 2. Fill in your actual local IP camera credentials and preferred directories.
# 3. The .env file is strictly ignored by Git (.gitignore) to prevent credential leaks.
# ==============================================================================

# [Required] RTSP stream URL for the IP Camera (TP-LINK TL-IPC44AW)
# Format: rtsp://<username>:<device_password>@<camera_ip>:<port>/<stream_channel>
# - stream1: High-Definition Main Stream (2.5K / 2560x1440, H.265, 15 FPS)
# - stream2: Sub Stream (lower resolution preview)
CCTV_RTSP_URL=rtsp://admin:your_camera_password@10.0.1.20:554/stream1

# [Optional] Local directory path where video segments are buffered before upload
# Default: /mnt/buffer/cctv
CCTV_BUFFER_DIR=/mnt/buffer/cctv

# [Optional] Duration of each video segment MP4 file in seconds
# Default: 900 (15 minutes)
CCTV_SEGMENT_SECONDS=900

# [Optional] Minimum free disk space threshold in Gigabytes
# If free disk space drops below this value, the circuit breaker pauses recording to protect the node.
# Default: 5
CCTV_MIN_FREE_DISK_GB=5

# [Optional] Initial backoff delay in seconds when reconnection is needed
# Default: 5
CCTV_RECONNECT_DELAY_SECONDS=5

# [Optional] Maximum exponential backoff delay ceiling in seconds
# Default: 60
CCTV_MAX_RECONNECT_DELAY_SECONDS=60
