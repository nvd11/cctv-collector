# Multi-stage Dockerfile for Quarkus CCTV Collector Service
# Stage 1: Build application using Temurin OpenJDK 21
FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /work
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY cctv-collector-service/pom.xml cctv-collector-service/
COPY cctv-uploader-service/pom.xml cctv-uploader-service/

# Cache maven dependencies
RUN ./mvnw -B dependency:go-offline -pl cctv-collector-service -am || true

# Copy sources and package
COPY cctv-collector-service/src cctv-collector-service/src
RUN ./mvnw -B package -DskipTests -pl cctv-collector-service -am

# Stage 2: Minimal runtime image with JRE 21 and FFmpeg
FROM eclipse-temurin:21-jre-jammy
ENV LANGUAGE='en_US:en'

# Install FFmpeg and clean apt cache
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg tzdata curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Non-root user setup
RUN groupadd -r cctv --gid 1000 && useradd -r -g cctv --uid 1000 -d /app cctv

COPY --from=build --chown=cctv:cctv /work/cctv-collector-service/target/quarkus-app/lib/ /app/lib/
COPY --from=build --chown=cctv:cctv /work/cctv-collector-service/target/quarkus-app/*.jar /app/
COPY --from=build --chown=cctv:cctv /work/cctv-collector-service/target/quarkus-app/app/ /app/app/
COPY --from=build --chown=cctv:cctv /work/cctv-collector-service/target/quarkus-app/quarkus/ /app/quarkus/

USER 1000

EXPOSE 8081
ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/app/quarkus-run.jar"

ENTRYPOINT [ "sh", "-c", "java $JAVA_OPTS -jar $JAVA_APP_JAR" ]
